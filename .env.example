# Public frontend values only. Copy to .env.local and fill in your own values.
VUE_APP_API_BASE_URL=https://YOUR_API_DOMAIN
# Public product name and copy are shared via backend/branding.json.
VUE_APP_OPERATOR=CHANGE_ME
VUE_APP_CONTACT=CHANGE_ME
# Set your AppID in src/manifest.json. Never put AppSecret here.
# Optional: VUE_APP_API_DEVELOPMENT / VUE_APP_API_TRIAL / VUE_APP_API_RELEASE
# Ads and purchasing are disabled by default; configure them on the backend.

# Only set to false for an isolated local backend explicitly running without authentication.
# VUE_APP_BACKEND_AUTH_REQUIRED=false
