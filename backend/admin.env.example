# Copy to backend/.env.admin when enabling admin.
# No API login-signing secret or push AES key is needed for local read-only management.
IDPHOTO_PAYMENT_ENABLED=false
IDPHOTO_API_LOCAL_URL=http://127.0.0.1:8090
IDPHOTO_PUBLIC_API_URL=
IDPHOTO_PUSH_ENABLED=false
IDPHOTO_PUSH_PORT=8092
# Enable refund/payment operations only after separately configuring and validating
# the corresponding WeChat payment credentials documented in backend/.env.example.
