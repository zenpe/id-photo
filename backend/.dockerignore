# Allow only the source needed by the API into the build context.
**
!Dockerfile
!branding.json
!brand-logo.svg
!requirements.txt
!requirements-api.lock
!constraints-api.txt
!hivision-core/
!hivision-core/requirements.txt
!hivision-core/requirements-app.txt
!hivision-core/hivision/
!hivision-core/hivision/**
!hivision-overlay/
!hivision-overlay/*.py
!hivision-overlay/miniapp_admin.html
!hivision-overlay/miniapp_admin.css
!hivision-overlay/miniapp_admin.js
!scripts/
!scripts/download_models.py
**/__pycache__/
**/*.pyc
**/*.onnx
**/.env*
**/*.key
**/*.pem
**/*.sqlite3*
**/.miniapp_data/
**/.miniapp_sandbox/
