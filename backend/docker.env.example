# Copy to backend/.env.docker. Edit locally on the NAS; never commit secrets.
# Use your own mini-program AppID and AppSecret.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Generate with the command in docs/deploy-fnos.md (at least 32 characters).
IDPHOTO_TOKEN_SECRET=
# Public operational capabilities. Defaults allow free saving without ads.
IDPHOTO_SAVE_MODE=free
IDPHOTO_REWARDED_AD_UNIT_ID=
IDPHOTO_AD_UNAVAILABLE=free
IDPHOTO_ASYNC_MEDIA_ENABLED=false
IDPHOTO_DIAGNOSTICS_ENABLED=false
IDPHOTO_PAYMENT_ENABLED=false
# CPU image workers and total running/queued jobs (single API process).
IDPHOTO_IMAGE_WORKERS=2
IDPHOTO_IMAGE_CAPACITY=4
